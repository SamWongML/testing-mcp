{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The authoritative check emits nothing, so declaration-portability (TS2742) is moot.
    // Turning it off lets corpus files use the ergonomic `export default defineTest({…})`
    // without a per-file type annotation to name the nested `zod` path (DX).
    "declaration": false
  },
  "include": [
    "packages/*/src/**/*",
    "tools/*/src/**/*",
    "infra/src/**/*",
    "infra/bin/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ]
}
